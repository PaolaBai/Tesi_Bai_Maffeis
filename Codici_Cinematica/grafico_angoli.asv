media_sani = media_sani(:).';
sd_sani = std(Matrice_Sani_Addu, 0, 1, 'omitnan');
sd_sani = sd_sani(:).';

media_patT0 = mean(Matrice_Patologici_Addu_affettoT0, 1, 'omitnan');
media_patT0 = media_patT0(:).';
sd_patT0 = std(Matrice_Patologici_Addu_affettoT0, 0, 1, 'omitnan');
sd_patT0 = sd_patT0(:).';

media_patT1 = mean(Matrice_Patologici_Addu_affettoT1, 1, 'omitnan');
media_patT1 = media_patT1(:).';
sd_patT1 = std(Matrice_Patologici_Addu_affettoT1, 0, 1, 'omitnan');
sd_patT1 = sd_patT1(:).';

figure('Color', 'w');
hold on; grid on;

% Palette Colori
col_sani = [0.2, 0.6, 0.85]; % Blu
col_patT0 = [0.85, 0.3, 0.3];  % Rosso
col_patT1 = [0.5, 0.2, 0.6];  % Viola

% SD
y_upper_sani = media_sani + sd_sani;
y_lower_sani = media_sani - sd_sani;
fill([t_norm, fliplr(t_norm)], [y_upper_sani, fliplr(y_lower_sani)], col_sani, 'EdgeColor', 'none', 'FaceAlpha', 0.25, 'HandleVisibility', 'off');

y_upper_patT0 = media_patT0 + sd_patT0;
y_lower_patT0 = media_patT0 - sd_patT0;
fill([t_norm, fliplr(t_norm)], [y_upper_patT0, fliplr(y_lower_patT0)], col_patT0, 'EdgeColor', 'none', 'FaceAlpha', 0.25, 'HandleVisibility', 'off');

y_upper_patT1 = media_patT1 + sd_patT1;
y_lower_patT1 = media_patT1 - sd_patT1;
fill([t_norm, fliplr(t_norm)], [y_upper_patT1, fliplr(y_lower_patT1)], col_patT1, 'EdgeColor', 'none', 'FaceAlpha', 0.25, 'HandleVisibility', 'off');

% media
h1 = plot(t_norm, media_sani, 'Color', col_sani, 'LineWidth', 2.5, 'DisplayName', 'Sani');
h2 = plot(t_norm, media_patT0,  'Color', col_patT0,  'LineWidth', 2.5, 'DisplayName', 'Patologici T0');
h3 = plot(t_norm, media_patT1,  'Color', col_patT1,  'LineWidth', 2.5, 'DisplayName', 'Patologici T1');

% grafico
xlabel('Ciclo di Movimento (%)', 'FontSize', 12, 'FontWeight', 'bold');
ylabel('Angolo Articolare [deg]', 'FontSize', 12, 'FontWeight', 'bold');
title(['Andamento Angolare: Addu '], 'FontSize', 13, 'FontWeight', 'bold');

xlim([0, 100]);
legend([h1, h2, h3], 'Location', 'best');
set(gca, 'Box', 'off', 'TickDir', 'out', 'FontSize', 11, 'FontName', 'Arial');

