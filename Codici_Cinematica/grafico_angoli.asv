                        elseif ll == 5         % vale per RandG

                            for mm = 1:length(sottocartelle6)       % scorro dx e sx
                                lato_corrente = sottocartelle6{mm};

                                if mm == 1           % sono in reach

                                    for oo = 1:length(sottocartelle_ar)         % scorro andata e ritorno
